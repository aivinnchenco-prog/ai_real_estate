[Unit]
Description=Open Home Multi-Agent API (amoCRM chat webhooks + health)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openhome
Group=openhome
WorkingDirectory=/opt/openhome/app/agent_6_qualifier
Environment=PYTHONPATH=/opt/openhome/app:/opt/openhome/app/agent_6_qualifier/src
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=OPENHOME_API_PRODUCTION=true
Environment=AMO_CHAT_WEBHOOK_HOST=127.0.0.1
Environment=AMO_CHAT_WEBHOOK_PORT=8000
Environment=AGENT7_BROWSER_PROFILES_DIR=/opt/openhome/runtime/browser_profiles
Environment=AGENT7_BROWSER_FAILURES_DIR=/opt/openhome/runtime/agent7_browser_failures
EnvironmentFile=-/opt/openhome/.env
ExecStart=/opt/openhome/venv/bin/python /opt/openhome/app/agent_6_qualifier/scripts/amo_chat_webhook_serve.py
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openhome-api

[Install]
WantedBy=multi-user.target
