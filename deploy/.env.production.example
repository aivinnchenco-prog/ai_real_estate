# Production env template for Open Home multi-agent API VPS.
# Copy to /opt/openhome/.env and fill secrets manually.
# NEVER commit a filled production .env.
#
# Domain: https://api.open-home.online
# App binds loopback only: 127.0.0.1:8000 (NGINX terminates TLS).

# ---------- runtime / bind ----------
OPENHOME_API_PRODUCTION=true
AMO_CHAT_WEBHOOK_HOST=127.0.0.1
AMO_CHAT_WEBHOOK_PORT=8000
AMO_CHAT_PUBLIC_BASE_URL=https://api.open-home.online
AGENT7_BROWSER_PROFILES_DIR=/opt/openhome/runtime/browser_profiles
AGENT7_BROWSER_FAILURES_DIR=/opt/openhome/runtime/agent7_browser_failures

# ---------- amoCRM CRM API (existing long-lived token; do not regenerate here) ----------
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=
AMO_DEFAULT_RESPONSIBLE_USER_ID=
AMO_MANAGER_RESPONSIBLE_USER_ID=
AMO_TASK_TYPE_ID=
AMO_TASKS_ENABLED=true

# ---------- Notion / Gemini / Telegram (Agent 6/7) ----------
NOTION_TOKEN=
NOTION_DATABASE_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TG_API_ID=
TG_API_HASH=
TG_SESSION=official_company
TG_PHONE=
TG_EXPECTED_USER_ID=
TG_EXPECTED_USERNAME=

# ---------- WhatsApp / Wazzup ----------
WA_PROVIDER=wazzup
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
WAZZUP_API_BASE_URL=https://api.wazzup24.com
WAZZUP_SEND_ENABLED=true
WAZZUP_WEBHOOK_ENABLED=true
WAZZUP_AUTO_REPLY_ENABLED=true
WAZZUP_EXTERNAL_AUTORESPONSE_CONFIRMED_OFF=true
WAZZUP_LIVE_ALLOWLIST_ENABLED=false
WAZZUP_LIVE_ALLOWLIST_PHONES=
WAZZUP_STAGE_MODE=false

# ---------- amoCRM Custom Chat Channels ----------
AMO_CHAT_AMOJO_BASE_URL=https://amojo.amocrm.ru
AMO_CHAT_ACCOUNT_ID=
AMO_CHAT_CLIENT_UUID=831ec8bc-1565-4c9c-a10d-80b4162dadb6
AMO_CHAT_OWNER_SILENT=true

AMO_CHAT_FB_TITLE=Open Home | Facebook Marketplace
AMO_CHAT_FB_CHANNEL_ID=
AMO_CHAT_FB_CHANNEL_SECRET=
AMO_CHAT_FB_BOT_ID=
AMO_CHAT_FB_SCOPE_ID=

AMO_CHAT_AIRBNB_TITLE=Open Home | Airbnb
AMO_CHAT_AIRBNB_CHANNEL_ID=
AMO_CHAT_AIRBNB_CHANNEL_SECRET=
AMO_CHAT_AIRBNB_BOT_ID=
AMO_CHAT_AIRBNB_SCOPE_ID=

# ---------- LIVE FLAGS (must stay false after first deploy) ----------
AMO_CHAT_WEBHOOK_ENABLED=false
AMO_CHAT_AIRBNB_ENABLED=false
AMO_CHAT_MIRROR_LIVE=false
AMO_CHAT_CONNECT_LIVE=false
AGENT7_LIVE_OUTREACH_ENABLED=true
AGENT7_FACEBOOK_MESSENGER_ENABLED=false
AGENT7_AIRBNB_MESSAGES_ENABLED=false

# Optional profile overrides (same Linux user as openhome-api / Playwright)
# AGENT7_FACEBOOK_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/facebook_owner_outreach
# AGENT7_AIRBNB_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/airbnb_owner_outreach

WAZZUP_WEBHOOK_HOST=127.0.0.1
WAZZUP_WEBHOOK_PORT=8765

# --- Facebook Chromium profiles (canonical architecture) ---
# Agent1 + Availability: FB_BROWSER_PROFILE=/opt/openhome/runtime/browser_profiles/facebook_owner_outreach
FB_BROWSER_PROFILE=/opt/openhome/runtime/browser_profiles/facebook_owner_outreach
AGENT7_FACEBOOK_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/facebook_agent7
AGENT9_FACEBOOK_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/facebook_agent9
OPENHOME_FB_LOCK_DIR=/opt/openhome/runtime/state/shared/locks
# Per-profile lock files: ${OPENHOME_FB_LOCK_DIR}/${profile_dir_name}.lock
