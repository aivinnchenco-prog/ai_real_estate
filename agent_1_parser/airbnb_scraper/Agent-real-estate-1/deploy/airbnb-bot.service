[Unit]
Description=Airbnb Telegram CRM bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agent-real-estate
Environment=PATH=/opt/agent-real-estate/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DISPLAY=:99
ExecStart=/opt/agent-real-estate/.venv/bin/python3 main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
