TELEGRAM_BOT_TOKEN=put_your_bot_token_here
FB_PARSER_BACKEND=crawl4ai
FB_PARSER_WORKSPACE=.
# Optional: pin the 3.11 venv (run_bot.sh already activates .venv311)
# FB_PARSER_PYTHON=.venv311/bin/python

# Facebook auth (NOT in FB_BROWSER_PROFILE!)
FB_EMAIL=your_email_or_phone
FB_PASSWORD=your_password
FB_BROWSER_PROFILE=.fb_profile
FB_HEADLESS=false
FB_HEADLESS_PARSER=true

# Proxy (optional)
FB_PROXY=

# Human-like delays (milliseconds)
FB_DELAY_MIN_MS=800
FB_DELAY_MAX_MS=2200
FB_PAGE_DELAY_SEC=4
