# Скопируй в .env и заполни значения (файл .env в git не попадает)
TG_BOT_TOKEN=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
CURSOR_API_KEY=

# Опционально
AIRBNB_CURRENCY=THB
MAX_PHOTOS_DOWNLOAD=0
PHOTO_DOWNLOAD_WORKERS=3
PARSER_PHOTO_WAIT_SEC=18
# Гибрид: на VPS поставь false — цены добирает Mac (scripts/price_worker_local.py)
PRICE_COLLECT_ENABLED=true
# Цены Airbnb: паузы / retry / фазы (без прокси)
PARSER_PAGE_SLEEP_SEC=4
PARSER_PAGE_SLEEP_JITTER_SEC=1.5
PRICE_FETCH_RETRIES=3
PRICE_RETRY_SLEEP_SEC=6
PRICE_PRIORITY_MONTHS=6
PRICE_BATCH_PAUSE_SEC=8
PRICE_REFILL_PASS=true
PRICE_CACHE_ENABLED=true
PRICE_CACHE_TTL_DAYS=7
TASK_POLL_INTERVAL_SEC=60
CURSOR_MODEL=composer-2.5
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=
DRIVE_ROOT_FOLDER_ID=
