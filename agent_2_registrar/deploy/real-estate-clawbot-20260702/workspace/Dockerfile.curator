FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY requirements-curator.txt requirements-curator.txt
RUN pip install --no-cache-dir -r requirements-curator.txt
COPY curator_service.py .
EXPOSE 8077
CMD ["uvicorn", "curator_service:app", "--host", "0.0.0.0", "--port", "8077", "--workers", "1"]
