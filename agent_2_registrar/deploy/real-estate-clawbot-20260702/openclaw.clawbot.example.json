{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-20250514"
      },
      "workspace": "/data/.openclaw/workspace"
    },
    "list": [
      {
        "id": "estate",
        "default": true,
        "workspace": "/data/.openclaw/workspace",
        "identity": {
