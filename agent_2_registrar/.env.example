# Скопируй в .env и заполни. НЕ коммить .env в git.

# ── Publisher: Notion CRM ──────────────────────────────────────
NOTION_API_KEY=
# ID базы из URL: e817ce50-e788-4992-8b86-c9c9fc1fbcf7
NOTION_DATABASE_ID=e817ce50-e788-4992-8b86-c9c9fc1fbcf7

# Статусы (должны совпадать с Notion — см. config/publisher.json)
NOTION_STATUS_READY=ready_to_post
NOTION_STATUS_TAKEN=video_in_progress
NOTION_STATUS_SCHEDULED=post_scheduled

# ── Publisher: Publora ───────────────────────────────────────────
PUBLORA_API_KEY=
# Получить: curl https://api.publora.com/api/v1/platform-connections -H "x-publora-key: KEY"
PUBLORA_PLATFORM_INSTAGRAM=
PUBLORA_PLATFORM_TIKTOK=
PUBLORA_PLATFORM_YOUTUBE=
PUBLORA_PLATFORM_FACEBOOK=

# Google Maps Places API (optional — точная pin-ссылка)
GOOGLE_MAPS_API_KEY=
NOUSHEN_CRM_API_URL=
NOUSHEN_CRM_API_KEY=
PARSER_PROXY_URL=
FFMPEG_PATH=ffmpeg
