# ============================================================
# ЕДИНЫЙ РЕЕСТР КЛЮЧЕЙ И ДОСТУПОВ ПРОЕКТА (Real Estate Agents)
# ============================================================
# Источник правды — корневой .env (копия этого файла с реальными
# значениями). Разнести значения по .env агентов:
#
#   python3 scripts/sync_env.py            # root .env -> агенты
#   python3 scripts/sync_env.py --collect  # собрать уже имеющиеся
#                                          # значения из агентов в root
#   python3 scripts/sync_env.py --dry-run  # показать без записи
#
# .env файлы в git не попадают (.gitignore), этот example — попадает.
# Над каждым ключом — короткая инструкция, где его взять.

# ---------- Notion (CRM-таблица) ----------
# 1) notion.so/my-integrations -> New integration (тип Internal)
# 2) скопировать Internal Integration Secret (начинается с ntn_)
# 3) ВАЖНО: открыть таблицу объектов -> меню «...» -> Connections ->
#    добавить свою интеграцию, иначе будет 404
NOTION_API_KEY=
# Открыть базу объектов в браузере. ID — 32 hex-символа в URL:
# notion.so/<workspace>/<ЭТО_ID>?v=...  (часть до знака «?»)
NOTION_DB_ID=
# Вторая интеграция — для страниц документации проекта (обзорная
# страница). Делается так же, расшаривается на страницы доков, не на базу
NOTION_DOCS_API_KEY=

# ---------- Cloudflare R2 (хранилище фото и видео) ----------
# dash.cloudflare.com -> R2. Account ID виден справа на странице R2
# (или в URL: dash.cloudflare.com/<ACCOUNT_ID>/r2)
CLOUDFLARE_ACCOUNT_ID=
# Всегда https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_ENDPOINT=
# R2 -> Create bucket. Сюда — имя созданного бакета
CLOUDFLARE_BUCKET=
# R2 -> Manage R2 API Tokens -> Create API Token (права Object Read & Write).
# Выдаст пару: Access Key ID + Secret Access Key. Secret показывают один раз!
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
# Бакет -> Settings -> Public access: включить r2.dev subdomain или
# подключить свой домен. Сюда — базовый URL, например https://pub-xxx.r2.dev
CLOUDFLARE_PUBLIC_BASE_URL=

# ---------- Metricool (Агент 4 — публикация в соц.сети) ----------
# Нужен платный план с API. metricool.com -> Settings -> API ->
# скопировать API token. ID пользователя и блога проще всего взять
# запросом GET https://app.metricool.com/api/admin/simpleProfiles?userToken=<токен>
# (в ответе userId и id профиля-бренда = blogId)
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# Часовой пояс планирования постов, менять не обязательно
METRICOOL_TIMEZONE=Asia/Bangkok

# ---------- Higgsfield / Seedance (Агент 3 — генерация видео) ----------
# Способ вызова: api | cli | mcp | auto. Оставить auto, если не уверены
SEEDANCE_PROVIDER=auto
# higgsfield.ai -> аккаунт (аватар) -> API / Developers -> Create API key.
# Выдаст пару key + secret
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Только если SEEDANCE_PROVIDER=mcp: токен OAuth выдаётся при подключении
# Higgsfield MCP (авторизация в браузере при первом подключении MCP-сервера)
HIGGSFIELD_MCP_ACCESS_TOKEN=

# ---------- Google Veo (альтернатива Seedance) ----------
# Отдельный ключ не нужен — работает через GEMINI_API_KEY.
# Сюда — имя модели, когда решим подключить (список: ai.google.dev/models)
VEO_MODEL=veo-3.0-generate

# ---------- LLM ----------
# Gemini (Qualifier-диалоги + описания Агента 2):
# aistudio.google.com/apikey -> Create API key. Бесплатного лимита
# хватает для тестов, для продакшена включить билинг в Google Cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude (опционально. Агент 1: fallback цены; Агент 2: fallback описаний):
# console.anthropic.com -> API Keys -> Create Key. Нужен billing с балансом
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# OpenAI — только для scrapegraphai-бэкенда FB-парсера (обычно не нужен):
# platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------- Telegram-боты (все токены выдаёт @BotFather) ----------
# В Telegram открыть @BotFather -> /newbot (или /token для существующего).
# Токен вида 1234567890:AAE...
# Бот Агента 1 — приём ссылок Airbnb/FB (@ai_agent_airbnb_bot)
TG_BOT_TOKEN_AGENT1=
# Легаси-бот FB-парсера; не нужен, если пользуетесь только объединённым ботом
TG_BOT_TOKEN_FB_PARSER=
# Бот Агента 4 — постинг в TG-канал. Добавить бота админом канала!
TG_BOT_TOKEN_PUBLISHER=
# Канал недвижимости, куда постит Агент 4: @username канала,
# либо числовой ID вида -100xxxxxxxxxx (переслать пост из канала
# боту @userinfobot — он покажет ID)
TELEGRAM_CHANNEL=@OpenHome_th
# Бот-алертер ошибок Qualifier: любой бот от BotFather.
# ERROR_CHAT_ID — ваш личный Telegram ID: написать боту @userinfobot,
# он ответит вашим ID. Затем нажать Start у бота-алертера
ERROR_BOT_TOKEN=
ERROR_CHAT_ID=
# Бот вызова живого менеджера: когда бронь подтверждена и клиент пишет снова,
# менеджеру приходит «клиент @username ожидает ответа». Создать бота у BotFather,
# MANAGER_CHAT_ID — Telegram ID менеджера (@userinfobot) или ID группы менеджеров.
# Если пусто — уведомления идут в бот ошибок выше.
MANAGER_BOT_TOKEN=
MANAGER_CHAT_ID=
# Telegram ID админов ботов через запятую (узнать свой — @userinfobot)
ADMIN_TG_IDS=5041767749

# ---------- Telegram-аккаунт Квалификатора (Агент 6, userbot) ----------
# Это НЕ бот, а обычный аккаунт. Зайти на my.telegram.org под номером
# аккаунта-квалификатора -> API development tools -> создать приложение.
# Скопировать App api_id (число) и App api_hash (строка)
TG_API_ID=
TG_API_HASH=
# Имя session-файла Telethon. Оставить как есть; файл создастся сам
# при первом запуске (спросит код из SMS/Telegram). Session-файл = вход
# в аккаунт, не публиковать и не коммитить!
TG_SESSION=agent7_userbot

# ---------- WhatsApp ----------
# Номер для брони в описаниях, международный формат с «+»
WHATSAPP_NUMBER=+66625124002
# Авторизация WhatsApp-аккаунта Квалификатора. Интеграции пока нет.
# Когда выберем провайдера (Whapi.cloud / Green-API / WhatsApp Business API) —
# зарегистрировать номер у провайдера, сюда его API URL и токен из кабинета
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ---------- Facebook-аккаунт для парсинга (Агент 1B) ----------
# Логин-пароль аккаунта FB, под которым парсим Marketplace.
# Лучше отдельный «рабочий» аккаунт, не личный: есть риск блокировки
FB_EMAIL=
FB_PASSWORD=
# Папка браузерного профиля (куки, сессия). Создаётся сама, не менять
FB_BROWSER_PROFILE=.fb_profile
# false = браузер виден (нужно при первом логине и капче), true = скрыт
FB_HEADLESS=false
# Прокси для FB-аккаунта (снижает риск блокировки). Купить у любого
# прокси-провайдера (резидентный, страна = страна аккаунта).
# Либо одной строкой: scheme://user:pass@host:port — либо по частям ниже
FB_PROXY=
FB_PROXY_SCHEME=
FB_PROXY_HOST=
FB_PROXY_PORT=
FB_PROXY_USER=
FB_PROXY_PASS=

# ---------- Facebook-аккаунты для ПОСТИНГА (Агент 4) ----------
# ВАЖНО: у КАЖДОГО вида постинга СВОЙ аккаунт. Не смешиваем ни с парсинговым
# (FB_EMAIL выше), ни между собой: бан одного аккаунта не заденет остальные.
# Логин-пароль нужны только как запасной вход при протухшей сессии —
# основная авторизация живёт в отдельном профиле браузера каждой ветки.
#
# Аккаунт для ПОСТИНГА В ГРУППЫ:
FB_GROUPS_EMAIL=
FB_GROUPS_PASSWORD=
FB_GROUPS_PROXY=
FB_GROUPS_BROWSER_PROFILE=.fb_groups_profile
#
# Аккаунт для MARKETPLACE:
FB_MARKETPLACE_EMAIL=
FB_MARKETPLACE_PASSWORD=
FB_MARKETPLACE_PROXY=
FB_MARKETPLACE_BROWSER_PROFILE=.fb_marketplace_profile

# ---------- amoCRM (Агент 6 — передача лидов) ----------
# Субдомен из адреса вашего кабинета: https://<СУБДОМЕН>.amocrm.ru
AMO_SUBDOMAIN=
# Кабинет amoCRM -> Настройки -> Интеграции -> Создать интеграцию
# (внешняя) -> вкладка «Ключи и доступы» -> Долгосрочный токен
AMO_ACCESS_TOKEN=
# Custom chat channel registration (Agent7 FB / Airbnb) — public webhook only
AMO_CHAT_CLIENT_UUID=831ec8bc-1565-4c9c-a10d-80b4162dadb6
AMO_CHAT_PUBLIC_BASE_URL=https://api.open-home.online
AMO_CHAT_WEBHOOK_ENABLED=false
AMO_CHAT_MIRROR_LIVE=false
AMO_CHAT_CONNECT_LIVE=false
AGENT7_LIVE_OUTREACH_ENABLED=false
AGENT7_FACEBOOK_MESSENGER_ENABLED=false
AGENT7_AIRBNB_MESSAGES_ENABLED=false

# ---------- Chatplace (Агент 4 — воронки) ----------
# Кабинет Chatplace -> настройки профиля/интеграций -> API key.
# MCP URL — из документации Chatplace (адрес их MCP-сервера)
CHATPLACE_API_KEY=
CHATPLACE_MCP_URL=

# ---------- Google Maps (Агент 2 — точные ссылки на карту) ----------
# console.cloud.google.com -> создать проект -> APIs & Services ->
# включить Places API и Geocoding API -> Credentials -> Create API key.
# Требует привязанного билинга (есть бесплатный месячный лимит)
GOOGLE_MAPS_API_KEY=

# ---------- Cursor SDK (команда /cursor в боте Агента 1, опционально) ----------
# cursor.com -> Dashboard -> Integrations/API -> Create API key
CURSOR_API_KEY=

# ---------- WhatsApp UI native-list sync (OPTIONAL visual convenience) ----------
# Secondary only. Canonical role = Agent 6 / Agent 7 / amoCRM.
# Default OFF + dry-run. Manual QR login: python3 scripts/whatsapp_ui_login.py
WHATSAPP_UI_SYNC_ENABLED=false
WHATSAPP_UI_DRY_RUN=true
WHATSAPP_UI_HEADLESS=false
WHATSAPP_UI_PROFILE_DIR=
WHATSAPP_UI_CLIENT_LIST_NAME=Client
WHATSAPP_UI_OWNER_LIST_NAME=Owner
WHATSAPP_UI_AGENT_LIST_NAME=Owner
WHATSAPP_UI_ACTION_DELAY_MS=2000
WHATSAPP_UI_MAX_ATTEMPTS=3
WHATSAPP_UI_PAGE_LOAD_TIMEOUT_MS=90000
WHATSAPP_UI_READY_EXTRA_WAIT_MS=5000
# Prefer installed Google Chrome (same Lists UI). Fallback: chromium
WHATSAPP_UI_BROWSER_CHANNEL=chrome
WHATSAPP_UI_LOCALE=ru-RU
# Prefer attaching to normal Chrome (scripts/whatsapp_ui_open_native_chrome.py):
WHATSAPP_UI_CDP_URL=http://127.0.0.1:9222
WHATSAPP_UI_USE_XVFB=true
WHATSAPP_UI_CHROME_BIN=

# ---------- Деплой ----------
# URL git-репозитория (GitHub -> кнопка Code -> HTTPS или SSH)
GIT_REMOTE_URL=
# Ветка, из которой деплоим на сервер
GIT_BRANCH=main
# Данные VPS от хостинг-провайдера: IP/домен сервера, SSH-пользователь,
# путь к папке проекта на сервере
VPS_HOST=
VPS_USER=
VPS_PROJECT_DIR=
