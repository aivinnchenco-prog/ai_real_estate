# ============================================================
# ЕДИНЫЙ РЕЕСТР КЛЮЧЕЙ И ДОСТУПОВ ПРОЕКТА (Real Estate Agents)
# ============================================================
# Источник правды — корневой .env (копия этого файла с реальными
# значениями). Разнести значения по .env агентов:
#
#   python3 scripts/sync_env.py            # root .env -> агенты
#   python3 scripts/sync_env.py --collect  # собрать уже имеющиеся
#                                          # значения из агентов в root
#   python3 scripts/sync_env.py --dry-run  # показать без записи
#
# .env файлы в git не попадают (.gitignore), этот example — попадает.

# ---------- Notion (CRM-таблица) ----------
# Интеграция с доступом к базе объектов
NOTION_API_KEY=
# ID базы (таблицы) объектов
NOTION_DB_ID=
# Интеграция с доступом к страницам документации проекта (обзорная страница)
NOTION_DOCS_API_KEY=

# ---------- Cloudflare R2 (фото и видео) ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ENDPOINT=
CLOUDFLARE_BUCKET=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_PUBLIC_BASE_URL=

# ---------- Metricool (Агент 4 — публикация в соц.сети) ----------
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_TIMEZONE=Asia/Bangkok

# ---------- Higgsfield / Seedance (Агент 3 — генерация видео) ----------
# api | cli | mcp | auto (см. AGENTS.md Агента 3)
SEEDANCE_PROVIDER=auto
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_MCP_ACCESS_TOKEN=

# ---------- Google Veo (альтернатива Seedance, через Gemini API) ----------
# Ключ тот же GEMINI_API_KEY; модель задаётся здесь, когда подключим
VEO_MODEL=veo-3.0-generate

# ---------- LLM ----------
# Gemini: Qualifier (диалоги) + Агент 2 (описания)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude: Агент 1 (fallback цены, лого на аватаре), Агент 2 (fallback описаний)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# OpenAI: только для scrapegraphai-бэкенда FB-парсера (опционально)
OPENAI_API_KEY=

# ---------- Telegram-боты (токены из @BotFather) ----------
# Агент 1 — объединённый бот парсинга (@ai_agent_airbnb_bot)
TG_BOT_TOKEN_AGENT1=
# Легаси-бот FB-парсера (можно не заполнять, если пользуетесь только объединённым)
TG_BOT_TOKEN_FB_PARSER=
# Агент 4 — публикация постов в TG-канал
TG_BOT_TOKEN_PUBLISHER=
# TG-канал по недвижимости, куда публикует Агент 4 (@username или -100…)
TELEGRAM_CHANNEL=
# Бот-алертер ошибок Qualifier + chat_id владельца
ERROR_BOT_TOKEN=
ERROR_CHAT_ID=
# Telegram ID админов ботов (через запятую)
ADMIN_TG_IDS=5041767749

# ---------- Telegram-аккаунт Квалификатора (Агент 6, userbot) ----------
# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Имя session-файла Telethon
TG_SESSION=agent7_userbot

# ---------- WhatsApp ----------
# Номер для брони в описаниях (дублируется в config/pipeline.json -> contacts)
WHATSAPP_NUMBER=+66625124002
# Авторизация WhatsApp-аккаунта Квалификатора (провайдер ещё не подключён:
# Whapi / Green-API / WABA — заполнить при интеграции)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ---------- Facebook-аккаунт для парсинга (Агент 1B) ----------
FB_EMAIL=
FB_PASSWORD=
# Папка браузерного профиля (не почта/пароль!)
FB_BROWSER_PROFILE=.fb_profile
FB_HEADLESS=false
# Прокси для FB-аккаунта (опционально): либо одной строкой, либо по частям
FB_PROXY=
FB_PROXY_SCHEME=
FB_PROXY_HOST=
FB_PROXY_PORT=
FB_PROXY_USER=
FB_PROXY_PASS=

# ---------- amoCRM (Агент 6 — передача лидов) ----------
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=

# ---------- Chatplace (Агент 4 — воронки) ----------
CHATPLACE_API_KEY=
CHATPLACE_MCP_URL=

# ---------- Google Maps (Агент 2 — точные ссылки на карту) ----------
GOOGLE_MAPS_API_KEY=

# ---------- Cursor SDK (команда /cursor в боте Агента 1, опционально) ----------
CURSOR_API_KEY=

# ---------- Деплой ----------
GIT_REMOTE_URL=
GIT_BRANCH=main
VPS_HOST=
VPS_USER=
VPS_PROJECT_DIR=
