# Notion (read/write listings table)
AGENT9_NOTION_TOKEN=
AGENT9_NOTION_DATABASE_ID=

# Google Gemini (interpreter + phrasing only)
AGENT9_GEMINI_API_KEY=
AGENT9_GEMINI_MODEL=gemini-2.0-flash

# Facebook Messenger profile (isolated from Agent1/Availability)
AGENT9_FACEBOOK_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/facebook_agent9
AGENT9_BROWSER_ENABLED=false

# Optional overrides
AGENT9_CONFIG_PATH=
AGENT9_DATA_DIR=
AGENT9_INTRO_LANGUAGE=ru

# Legacy profile backup (do not delete until manual re-auth):
# ${AGENT9_DATA_DIR:-data}/facebook_profile
