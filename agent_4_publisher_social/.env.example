# Notion CRM (та же БД, что у Real Estate Agent)
NOTION_API_KEY=
NOTION_DB_ID=e817ce50-e788-4992-8b86-c9c9fc1fbcf7

# Опционально: подтянуть .env из Real Estate Agent, если ключи уже там
# REAL_ESTATE_ENV=/Users/lifefmg/Desktop/Агенты/Real Estate Agent/.env

# Статус очереди в Notion
NOTION_STATUS_READY=ready_to_post

# Android (ADB). Пусто = первый подключённый device / эмулятор
ANDROID_SERIAL=
# Папка на телефоне, куда кладём медиа перед постингом
ANDROID_MEDIA_DIR=/sdcard/Download/publisher_social

# ADB device: serial из `adb devices` или host:port для Wi‑Fi ADB
# ANDROID_SERIAL=192.168.1.10:5555

# Сколько секунд ждать единый lock телефона/state. 0 = сразу завершиться с кодом 3.
PUBLISHER_LOCK_TIMEOUT=0

# FB Groups + Marketplace: browser (Playwright Agent 7) или phone (ADB/Termux).
PUBLISHER_FB_BACKEND=browser
AGENT7_FACEBOOK_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/facebook_agent7
AGENT7_FB_HEADLESS=true
OPENHOME_FB_LOCK_DIR=/opt/openhome/runtime/state/shared/locks

# Режим: dry-run по умолчанию не трогает Notion и не кликает в приложениях
# PUBLISHER_DRY_RUN=0
