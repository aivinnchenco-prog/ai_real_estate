{
  "$comment": "Publisher social — Notion + R2 → Android phone → TikTok / Instagram / FB Marketplace / FB Groups. Без Metricool и без Playwright.",
  "channels": [
    "tiktok",
    "tiktok_carousel",
    "instagram_reel",
    "instagram_carousel",
    "youtube_shorts",
    "linkedin",
    "twitter",
    "fb_groups",
    "fb_marketplace"
  ],
  "timezone": "Asia/Bangkok",
  "limits": {
    "max_objects_per_run": 1,
    "min_minutes_between_posts": 120,
    "$comment_gap": "Пауза между НОВЫМИ объектами: читаем Notion «Дата и время публикации» у последнего объекта. Если прошло >= 120 мин — публикуем сразу. Уже начатый объект (колонка заполнена / есть прогресс) добивается без паузы.",
    "per_channel_daily_max": {
      "tiktok": 3,
      "tiktok_carousel": 2,
      "instagram_reel": 2,
      "instagram_carousel": 1,
      "fb_marketplace": 5,
      "fb_groups": 5,
      "linkedin": 2,
      "twitter": 3,
      "youtube_shorts": 2
    }
  },
  "media": {
    "max_carousel_images": 10,
    "max_marketplace_images": 20,
    "max_groups_images": 10,
    "hook_cover_first": true,
    "allow_raw_gallery_fallback": false,
    "$comment_raw_fallback": "false = карусели только из Notion carousel_url (слайды с шаблоном). Сырая колонка «Фото» не используется.",
    "cache_dir": "data/media"
  },
  "notion": {
    "database_title": "Аренда недвижимости",
    "fields": {
      "title": "Название объекта",
      "object_id": "Объект ID",
      "status": "Статус",
      "photo": "Фото",
      "carousel_url": "carousel_url",
      "brand_open_home_url": "brand_open_home_url",
      "caption_social": "Описание соц.сети",
      "caption_fb": "Описание для FB Marketplace",
      "cta_instagram": "CTA Instagram",
      "title_youtube_shorts": "Название YouTube Shorts",
      "caption_youtube_shorts": "Описание YouTube Shorts",
      "district": "Район",
      "address": "Адрес",
      "housing_type": "Тип жилья",
      "rooms": "Количество комнат",
      "bathrooms": "Количество сан.узлов",
      "price_monthly": "Цена за месяц",
      "google_maps": "Google Maps",
      "video_url_seedance": "video_url_Seedance",
      "video_url_vertical": "video_url_vertical",
      "post_url_tiktok": "post_url_tiktok",
      "post_url_tiktok_carousel": "post_url_tiktok_carousel",
      "post_url_instagram_reel": "post_url_instagram_reel",
      "post_url_instagram_carousel": "post_url_instagram_carousel",
      "post_url_facebook": "post_url_facebook",
      "post_url_fb_groups": "post_url_fb_groups",
      "post_url_linkedin": "post_url_linkedin",
      "post_url_x": "post_url_x",
      "post_url_youtube": "post_url_youtube",
      "post_url_threads": "post_url_threads",
      "published_at": "Дата и время публикации",
      "publish_error": "last_error",
      "error_count": "error_count"
    },
    "statuses": {
      "ready": "ready_to_post"
    },
    "phone_lock_fields": {
      "$comment": "Опциональные колонки для межхостовой координации. На одном хосте используется data/publisher.lock; эти Notion-поля пока не задействованы.",
      "locked": "phone_publisher_locked",
      "taken_at": "phone_publisher_taken_at",
      "log": "phone_publisher_log",
      "tiktok_done": "phone_tiktok_done",
      "tiktok_carousel_done": "phone_tiktok_carousel_done",
      "instagram_reel_done": "phone_instagram_reel_done",
      "instagram_carousel_done": "phone_instagram_carousel_done",
      "fb_marketplace_done": "phone_fb_marketplace_done",
      "fb_groups_done": "phone_fb_groups_done",
      "linkedin_done": "phone_linkedin_done",
      "twitter_done": "phone_twitter_done",
      "youtube_shorts_done": "phone_youtube_shorts_done"
    }
  },
  "orchestration": {
    "one_channel_per_live_run": true,
    "automatic_live_retries": false,
    "video_channels": ["tiktok", "instagram_reel", "youtube_shorts"],
    "carousel_channels": ["linkedin", "twitter", "fb_groups"],
    "final_channels": ["fb_marketplace"],
    "delayed_carousel": {
      "tiktok_carousel": {"after": "tiktok", "delay_minutes": 60},
      "instagram_carousel": {"after": "instagram_reel", "delay_minutes": 60}
    },
    "$comment_order": "Live: ровно один канал за запуск, затем процесс завершается для отчёта/ручной проверки. Порядок: video → carousel → final; fb_marketplace всегда последний."
  },
  "verification": {
    "post_url_source": "api",
    "capture_post_url_on_android": false,
    "url_optional_channels": [
      "tiktok",
      "tiktok_carousel",
      "instagram_reel",
      "instagram_carousel",
      "youtube_shorts",
      "linkedin",
      "twitter",
      "fb_groups",
      "fb_marketplace"
    ],
    "$comment": "Телефон только публикует. Отсутствие URL после Android live считается accepted; ссылки будут записаны позже отдельной API-интеграцией."
  },
  "youtube_shorts": {
    "album": "Видео",
    "max_title_chars": 100,
    "max_description_chars": 5000,
    "location": "Phuket",
    "location_aliases": ["Phuket, Thailand", "Phuket", "Amphoe Thalang", "Пхукет"],
    "audience": "not_for_kids",
    "title_formula": "Аренда {вилла|квартира} {N}BR Phuket {Район}",
    "set_related_video": false,
    "notes": "Пикер: «Видео», верхний-левый. После «Загрузить» Android-сценарий завершается; URL позже поступит через API."
  },
  "linkedin": {
    "album": "publisher_social",
    "max_images": 8,
    "use_caption_fb": false,
    "notes": "Создать → Фото/альбом → текст → Разместить. После публикации URL через телефон не копируется."
  },
  "twitter": {
    "video_album": "Видео",
    "image_album": "publisher_social",
    "media": "video",
    "max_images": 4,
    "max_chars": 280,
    "use_caption_fb": false,
    "set_location": true,
    "location": "Phuket",
    "location_aliases": [
      "Amphoe Thalang, Changwat Phuket",
      "Phuket, Thailand",
      "Changwat Phuket, Thailand",
      "Amphoe Thalang",
      "Phuket"
    ],
    "notes": "X video: Фотографии → Видео → последнее видео в списке → Готово → текст → место → Опубликовать. После публикации URL через телефон не копируется. media=images для фото (макс 4)."
  },
  "tiktok": {
    "location": "Пхукет",
    "location_aliases": ["Пхукет", "Phuket"],
    "video_album": "Видео",
    "carousel_album": "publisher_social",
    "carousel": {
      "enabled": true,
      "max_images": 8
    }
  },
  "instagram": {
    "location": "Phuket, Thailand",
    "location_aliases": [
      "Phuket, Thailand",
      "Phuket",
      "Пхукет",
      "Phuket Island, Thailand"
    ],
    "video_album": "Видео",
    "carousel_album": "publisher_social",
    "share_to_threads": false,
    "share_to_facebook": false,
    "share_to_story": false,
    "audience": "public",
    "reel": {
      "enabled": true
    },
    "carousel": {
      "enabled": true,
      "max_images": 8
    },
    "notes": "Reel: + → новое видео → галерея «Видео» → последнее видео в списке → Далее → подпись → место → Далее → Поделиться. После публикации URL через телефон не копируется. Кросспост Threads/FB/Story — дефолты в приложении IG, UI не трогаем."
  },
  "fb_marketplace": {
    "create_path_hint": "Marketplace → Продать → Продажа и аренда недвижимости",
    "rent_or_sale": "rent",
    "location_suffix": "Phuket",
    "address_search": "Thalang Phuket",
    "address_fallback": "Amphoe Thalang",
    "album": "brand_open_home",
    "device_media_dir": "/sdcard/Download/brand_open_home",
    "max_images": 8,
    "notes": "Фото ТОЛЬКО из Notion brand_open_home_url → альбом brand_open_home. Ссылку на объявление не копируем."
  },
  "fb_groups": {
    "groups_file": "config/fb_groups_list.txt",
    "max_groups_per_object": 2
  },
  "android": {
    "config_file": "config/android.json"
  },
  "chatplace": {
    "enabled": true,
    "$comment": "После post_url_instagram_reel вызывается agent_4_publisher/scripts/spawn_chatplace_for_reel.py"
  }
}
