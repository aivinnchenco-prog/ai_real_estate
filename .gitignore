# Publisher social (телефон): весь runtime, включая профили браузера и их бэкапы.
# Раньше перечисляли подкаталоги поимённо, и копия Chrome-профиля на 2000 файлов
# оказалась вне правил.
agent_4_publisher_social/data/*
!agent_4_publisher_social/data/.gitkeep
agent_4_publisher_social/.env
agent_4_publisher_social/runner.env

# Кит с FB-профилем и ключами для веток публикатора (секреты, вне git)
agent_4_publisher_fb/

# Runtime-данные веток FB групп/маркетплейса (state, debug-скриншоты, tmp-фото)
agent_4_publisher/data/fb_groups/
agent_4_publisher/data/fb_marketplace/
agent_4_publisher/data/fb_account/

# Профиль браузера постинг-аккаунта FB (секрет, вне git)
