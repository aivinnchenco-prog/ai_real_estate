# Agent 10 — Performance Marketer (local only)
# Copy to .env and fill. Never commit secrets.

# ── Notion (read-only for V1) ───────────────────────────────────────────
AGENT10_NOTION_TOKEN=
AGENT10_NOTION_DATABASE_ID=

# ── PostMyPost (analytics/publications) ─────────────────────────────────
# Same credential names as Agent 4 publisher when connecting later.
POSTMYPOST_API_TOKEN=
POSTMYPOST_TOKEN=
POSTMYPOST_BASE_URL=https://api.postmypost.io/v4.1
POSTMYPOST_TIMEZONE=Asia/Bangkok

# ── Budget caps (THB). Agent MUST NOT recommend / create above MAX. ─────
TARGET_DEFAULT_DAILY_BUDGET=500
TARGET_MAX_DAILY_BUDGET=1500
TARGET_DEFAULT_DURATION_DAYS=5
TARGET_MAX_DURATION_DAYS=14
TARGET_MAX_TOTAL_BUDGET=2500
# Future budget-change step limit (interface only; no live mutations yet)
TARGET_MAX_BUDGET_CHANGE_PCT=20

# ── Scoring / windows ───────────────────────────────────────────────────
AGENT10_MIN_AGE_HOURS=1
AGENT10_CONFIG_DIR=
AGENT10_DATA_DIR=

# ── Optional LLM / MarketingBrain (DISABLED — never calls Meta) ─────────
AGENT10_LLM_PROVIDER=
AGENT10_LLM_MODEL=
AGENT10_LLM_API_KEY=
AGENT10_LLM_ENABLED=false

# ── Meta Marketing API (Open Home th) ───────────────────────────────────
# Fill META_ACCESS_TOKEN locally. Never commit the token.
META_APP_ID=1051487844031310
META_BUSINESS_ID=1572755037543832
META_AD_ACCOUNT_ID=3462495317264561
META_PAGE_ID=1189108177625326
META_INSTAGRAM_ACCOUNT_ID=17841410402639080
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_API_BASE_URL=https://graph.facebook.com
# Optional — not required for server-to-server Marketing API calls today:
# META_APP_SECRET=

# Safety switches (default: read-only)
META_ADS_ENABLED=false
META_WRITE_ENABLED=false
META_ACTIVE_ENABLED=false

# Diagnostic expectations
META_EXPECTED_ACCOUNT_NAME=Open Home th
META_EXPECTED_CURRENCY=THB
META_EXPECTED_TIMEZONE=Asia/Bangkok
META_DIAGNOSTIC_STRICT=false
