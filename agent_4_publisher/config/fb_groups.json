    "min_minutes_between_posts": 45,
    "min_minutes_between_posts_same_group": 1440
  },
  "media": {
    "max_images": 10,
    "hook_cover_first": true
  },
  "browser": {
    "profile_env": "FB_GROUPS_BROWSER_PROFILE",
    "default_profile": ".fb_profile",
    "headless_env": "FB_HEADLESS",
    "viewport": {"width": 1440, "height": 900},
    "nav_timeout_ms": 90000,
