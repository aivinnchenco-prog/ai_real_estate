{
  "object_id": {
    "format": "YYYYMMDD_NNN",
    "example": "20260701_001"
  },
  "metricool": {
    "timezone": "Asia/Bangkok",
    "planner_calendar_url": "https://app.metricool.com/planning/calendar",
    "post_search_days_back": 14,
    "post_search_days_ahead": 2,
    "url_sync_delay_minutes": 5,
    "url_sync_retries": 3,
    "url_sync_retry_interval_minutes": 3,
    "docs": "https://app.metricool.com/resources/apidocs/index.html",
    "min_hours_between_posts": 3,
    "default_video_gap_hours": 4,
    "seo": {
      "adapt_caption_per_platform": true,
      "max_hashtags": 30,
      "hashtag_randomize": {
        "enabled": true,
        "pick_min": 10,
        "pick_max": 18,
        "always_include": [
          "#TripHomePhuket",
          "#Phuket"
        ],
        "pool_pick": {
          "location": 3,
          "rent": 3,
          "property": 2,
          "lifestyle": 2,
          "ru": 2,
          "en": 2
        },
        "pools": {
          "location": [
            "#BangTao",
            "#ChoengThale",
            "#PhuketThailand",
            "#LagunaPhuket",
            "#SurinBeach",
            "#LayanBeach",
            "#CherngTalay",
            "#Thalang"
          ],
          "rent": [
            "#PhuketRent",
            "#RentPhuket",
            "#PhuketRental",
            "#PhuketProperty",
            "#ThailandRent",
            "#LongTermRent",
            "#ShortTermRent",
            "#VacationRent"
          ],
          "property": [
            "#CondoPhuket",
            "#VillaPhuket",
            "#PoolView",
            "#BeachLife",
            "#LuxuryCondo",
            "#TropicalLiving",
            "#RealEstatePhuket",
            "#InvestmentProperty"
          ],
          "lifestyle": [
            "#IslandLife",
            "#ExpatLife",
            "#DigitalNomad",
            "#TravelThailand",
            "#WorkFromParadise",
            "#TropicalVibes",
            "#BeachVibes",
            "#SunsetLovers"
          ],
          "ru": [
            "#АрендаПхукет",
            "#НедвижимостьПхукет",
            "#Пхукет",
            "#АрендаТаиланд",
            "#ЖильеПхукет",
            "#КвартираПхукет",
            "#ВиллаПхукет",
            "#ОтдыхТаиланд"
          ],
          "en": [
            "#PhuketLife",
            "#ThailandProperty",
            "#RentInThailand",
            "#PhuketCondo",
            "#PhuketVilla",
            "#PropertyForRent",
            "#HolidayHome",
            "#SeaView"
          ]
        }
      },
      "hashtag_placement": {
        "instagram": "first_comment",
        "tiktok": "caption",
        "facebook": "caption",
        "twitter": "caption",
        "x": "caption",
        "linkedin": "caption",
        "threads": "caption"
      },
      "platform_limits": {
        "instagram": 2200,
        "tiktok": 2200,
        "x": 280,
        "twitter": 280,
        "threads": 500,
        "linkedin": 3000
      },
      "platform_adapters": {
        "x": {
          "strip_urls": true,
          "max_hashtags_in_caption": 5
        },
        "twitter": {
          "strip_urls": true,
          "max_hashtags_in_caption": 5
        },
        "threads": {
          "strip_urls": true,
          "max_hashtags_in_caption": 8
        },
        "linkedin": {
          "strip_urls": false
        },
        "instagram": {},
        "tiktok": {},
        "facebook": {}
      },
      "location_search": {
        "enabled": true,
        "networks": [
          "instagram",
          "facebook"
        ],
        "query_fields": [
          "district",
          "address"
        ],
        "fallback_query": "Phuket, Thailand",
        "fallback_locations": [
          {
            "district_match": [
              "Choeng Thale",
              "Bang Tao",
              "Бангтао",
              "Bangtao"
            ],
            "location": {
              "name": "Bang Tao Beach, Phuket",
              "id": "100957738648887",
              "link": "https://www.facebook.com/100957738648887",
              "location": {
                "latitude": 7.98474,
                "longitude": 98.29499,
                "city": "Phuket",
                "country": "Thailand",
                "street": "Bang Tao, Choeng Thale",
                "zip": "83110"
              }
            }
          }
        ]
      }
    }
  },
  "agent6": {
    "count_force_as_quota": false,
    "default_mode": "auto",
    "workflow_order": [
      "telegram",
      "metricool",
      "chatplace"
    ],
    "chain_metricool_after_telegram": true,
    "per_network_daily_limit": {
      "max_posts_per_day": 4,
      "carousel_max": 1,
      "video_max": 3,
      "video_only_networks": {
        "youtube": {
          "video_max": 3,
          "carousel_max": 0
        }
      }
    }
  },
  "notion": {
    "database_url": "https://app.notion.com/p/e817ce50e78849928b86c9c9fc1fbcf7",
