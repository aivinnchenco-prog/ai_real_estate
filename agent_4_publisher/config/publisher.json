  "publish_platforms": [
    "instagram",
    "tiktok",
    "x",
    "linkedin",
    "facebook",
    "youtube",
    "threads"
  ],
  "video_format_by_platform": {
    "instagram": "seedance",
    "tiktok": "seedance",
    "facebook": "seedance",
    "twitter": "seedance",
    "x": "seedance",
    "linkedin": "seedance",
    "threads": "seedance"
  },
  "carousel": {
    "enabled": true,
    "max_images": 10,
    "max_images_by_platform": {
      "instagram": 10,
      "facebook": 10,
      "tiktok": 20,
      "twitter": 4,
      "x": 4,
      "linkedin": 9,
      "threads": 10
    },
    "min_images_by_platform": {
      "facebook": 2,
      "tiktok": 2,
      "instagram": 2
    },
    "diverse_images": true,
    "max_per_category": 1,
    "platforms": [
      "instagram",
      "tiktok",
      "facebook",
      "x",
      "linkedin",
      "threads"
    ],
    "image_only_when_carousel": [
      "instagram",
      "twitter",
      "x",
      "linkedin",
      "facebook",
      "threads"
    ]
  },
  "video_post": {
    "enabled": true,
    "source_field": "video_url_Seedance",
    "platforms": [
      "instagram",
      "tiktok",
      "facebook",
      "x",
      "linkedin",
      "threads"
    ]
  },
  "platform_capabilities": {
    "instagram": {
      "carousel": true,
      "video": true
    },
    "tiktok": {
      "carousel": true,
      "video": true
    },
    "facebook": {
      "carousel": true,
      "video": true
    },
    "twitter": {
      "carousel": true,
      "video": true
    },
    "x": {
      "carousel": true,
      "video": true
    },
    "linkedin": {
      "carousel": true,
      "video": true
    },
    "threads": {
      "carousel": true,
      "video": true
    },
    "youtube": {
      "carousel": false,
      "video": true
    }
  },
  "metricool_platform_settings": {
    "instagram": {
      "showReelOnFeed": true
    },
    "facebook": {},
    "tiktok": {
      "privacyOption": "PUBLIC_TO_EVERYONE",
      "autoAddMusic": true,
      "photoCoverIndex": 0,
      "disableComment": false,
      "disableDuet": false,
      "disableStitch": false
    },
    "youtube": {
      "type": "short",
      "privacy": "public",
      "madeForKids": false
    },
    "twitter": {
      "tags": []
    },
    "threads": {},
    "linkedin": {
      "type": "post"
    }
  },
  "telegram": {
    "channel": "@OpenHome_th",
    "media": "images_only",
    "source_field": "photo",
    "caption_field": "Описание для Telegram",
    "max_images": 10,
    "publish_video": false,
    "diverse_images": true,
    "max_per_category": 1,
    "strip_urls": true,
    "strip_url_patterns": [
      "airbnb",
      "booking.com",
      "agoda",
      "vrbo",
      "tripadvisor",
      "facebook.com/marketplace"
    ],
    "append_object_hashtag": false,
    "append_contact_phone": false,
    "append_google_maps": true,
    "chain_metricool_after_telegram": true
  },
  "chatplace": {
    "enabled": false,
    "execution": "mcp",
    "use_structured_mcp": true,
    "mcp_url": "https://mcp.chatplace.io/mcp",
    "delay_minutes_after_publish": 15,
    "platforms": [
      "instagram"
    ],
    "instagram_post_kinds": [
      "carousel",
      "reel"
    ],
    "instagram_comment_trigger": "commentAnyValue",
    "trigger_keyword": "+",
    "default_instagram_cta": "Оставьте «+» в комментарии — пришлём полную информацию об объекте в Direct.",
    "dm_message_template": "Полная информация об объекте {object_id}: {telegram_url}",
    "funnel_name_template": "{object_id}",
    "trigger_keyword_from": "object_id",
    "funnel_action": "send_telegram_post_link"
  },
  "instagram": {
    "reel_delay_hours": 4
  }
}