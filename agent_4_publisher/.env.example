# Notion CRM
NOTION_API_KEY=
NOTION_DB_ID=e817ce50-e788-4992-8b86-c9c9fc1fbcf7

# ── Metricool ───────────────────────────────────────────────────────────
# Нужен план Advanced или Custom: https://metricool.com/metricool-premium/
#
# METRICOOL_USER_TOKEN (userToken):
#   1. Войти на https://app.metricool.com/
#   2. Меню ☰ → Account settings (Настройки аккаунта)
#   3. Вкладка «API» → скопировать userToken
#   4. В запросах передаётся в заголовке: X-Mc-Auth: <token>
#
# METRICOOL_USER_ID и METRICOOL_BLOG_ID:
#   1. Откройте нужный бренд (brand) в Metricool
#   2. Посмотрите URL в браузере — там query-параметры:
#      https://app.metricool.com/...?userId=1234567&blogId=7654321
#   3. userId — ваш аккаунт, blogId — конкретный бренд (у каждого бренда свой)
#
# Проверка после заполнения:
#   python3 scripts/list_brands.py
#
# MCP (Cursor / Clawbot / OpenClaw / Hermes):
#   docs/METRICOOL_MCP.md
#   config/metricool-mcp.cursor.example.json
#
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Часовой пояс для планировщика
METRICOOL_TIMEZONE=Asia/Bangkok

# ── Telegram (публикация в канал) ───────────────────────────────────────
# Канал: @trip_home_phuket — только фото, без Seedance
# 1) @BotFather → создать бота → TELEGRAM_BOT_TOKEN
# 2) Добавить бота админом в @trip_home_phuket с правом «Публикация сообщений»
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@trip_home_phuket

# CURATOR_URL=http://127.0.0.1:8077
#   python3 scripts/publish_telegram.py --check-bot
#   python3 scripts/list_brands.py

# Опционально: переопределить статусы Notion
# NOTION_STATUS_READY=ready_to_post
# NOTION_STATUS_TAKEN=video_in_progress
# NOTION_STATUS_SCHEDULED=ready_to_post
# NOTION_STATUS_FAILED=video_failed

# ── ChatPlace MCP (phase 5 — после тестов TG + Metricool) ───────────────
# API key из настроек ChatPlace → https://chatplace.io
# В Cursor: Customize → MCP → выключите chatplace, пока ключ пустой
CHATPLACE_API_KEY=
CHATPLACE_FUNNEL_TEMPLATE_ID=
