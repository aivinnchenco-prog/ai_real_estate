[Unit]
Description=OpenHome WhatsApp UI list-sync queue worker (one-shot)
After=network-online.target whatsapp-ui-chrome.service
Wants=network-online.target

[Service]
Type=oneshot
User=REPLACE_USER
WorkingDirectory=REPLACE_ROOT
EnvironmentFile=-REPLACE_ROOT/agent_6_qualifier/.env
EnvironmentFile=-REPLACE_ROOT/.env
Environment=PYTHONUNBUFFERED=1
Environment=WHATSAPP_UI_CDP_URL=http://127.0.0.1:9222
ExecStart=REPLACE_ROOT/scripts/run_whatsapp_ui_queue_worker.sh
StandardOutput=journal
StandardError=journal
