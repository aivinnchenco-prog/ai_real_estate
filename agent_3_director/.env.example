# Video engine: wan (default, fal.ai Wan 2.7 @ 720p) | seedance (Higgsfield)
VIDEO_ENGINE=wan
FAL_KEY=

# Seedance provider: cli (OAuth, рекомендуется) | mcp | api | auto
SEEDANCE_PROVIDER=cli
HIGGSFIELD_CLI_BIN=higgsfield

# Platform API (fallback, 1 фото — DoP, не multi-ref)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# MCP OAuth token (опционально)
# HIGGSFIELD_MCP_ACCESS_TOKEN=

# Notion CRM
NOTION_API_KEY=
NOTION_DB_ID=

# Cloudflare R2 — фото объекта + upload результата
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET=
CLOUDFLARE_PUBLIC_BASE_URL=
