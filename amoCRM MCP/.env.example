# amoCRM read-only credentials (separate from Agent 6)
AMO_MCP_SUBDOMAIN=
AMO_MCP_ACCESS_TOKEN=

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8787
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_API_TOKEN=

# Optional cache TTL seconds for static metadata (pipelines, fields, users)
MCP_CACHE_TTL_SECONDS=600

# Transport: streamable-http (production) or stdio (local dev)
MCP_TRANSPORT=streamable-http
