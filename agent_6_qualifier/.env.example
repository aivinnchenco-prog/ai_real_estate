# Notion (та же база, что у Agents 2/6)
NOTION_TOKEN=
NOTION_DATABASE_ID=e817ce50-e788-4992-8b86-c9c9fc1fbcf7

# amoCRM
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram — ЛИЧНЫЙ аккаунт (MTProto userbot), не бот
TG_API_ID=
TG_API_HASH=
TG_SESSION=agent7_userbot

# WhatsApp — production: Wazzup24 (https://wazzup24.com)
WA_PROVIDER=wazzup
WAZZUP_API_BASE_URL=https://api.wazzup24.com
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
WAZZUP_SEND_ENABLED=false
# Legacy fallback (не используется если Wazzup настроен):
# WA_PROVIDER=greenapi
# WA_INSTANCE_ID=
# WA_API_TOKEN=

# Human handoff TTL (hours of manager silence before bot may resume)
AGENT6_HUMAN_HANDOFF_TTL_HOURS=48


# Facebook owner communication (отдельный profile, не FB_BROWSER_PROFILE)
AGENT7_FACEBOOK_PROFILE_DIR=/opt/openhome/runtime/browser_profiles/facebook_agent7
AGENT7_FACEBOOK_MESSENGER_ENABLED=false
AGENT7_FB_HEADLESS=true

# Информационный TG-бот для ошибок проекта (обычный бот от @BotFather)
# Настройка: scripts/error_bot_setup.py
ERROR_BOT_TOKEN=
ERROR_CHAT_ID=
