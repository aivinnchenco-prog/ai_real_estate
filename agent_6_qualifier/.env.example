# Notion (та же база, что у Agents 2/6)
NOTION_TOKEN=
NOTION_DATABASE_ID=e817ce50-e788-4992-8b86-c9c9fc1fbcf7

# amoCRM
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=
AMO_DEFAULT_RESPONSIBLE_USER_ID=
AMO_MANAGER_RESPONSIBLE_USER_ID=
AMO_TASK_TYPE_ID=
AMO_TASKS_ENABLED=true

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram — корпоративный user account (MTProto / Telethon), не бот
# Test session (сохранить): agent7_userbot
# Official corporate session (отдельный файл, test не перезаписывать):
TG_API_ID=
TG_API_HASH=
TG_SESSION=official_company
TG_PHONE=
TG_EXPECTED_USER_ID=
TG_EXPECTED_USERNAME=

# WhatsApp transport = Wazzup (channel already connected externally + amoCRM)
# Fill ONLY WAZZUP_API_KEY locally. Never commit the key.
WA_PROVIDER=wazzup
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=7ac4092a-cf3c-450f-8518-d7cc7bd3f995
WAZZUP_API_BASE_URL=https://api.wazzup24.com
WAZZUP_SEND_ENABLED=false
WAZZUP_WEBHOOK_ENABLED=false
WAZZUP_AUTO_REPLY_ENABLED=false
# Set true ONLY after manual UI check: WA Business / Wazzup / amoCRM greetings OFF
WAZZUP_EXTERNAL_AUTORESPONSE_CONFIRMED_OFF=false
WAZZUP_REQUEST_TIMEOUT_SECONDS=15
# Optional public HTTPS URL for readiness probe (never write secrets here)
# WAZZUP_PUBLIC_WEBHOOK_URL=
# WAZZUP_LOCAL_WEBHOOK_URL=http://127.0.0.1:8765/health
# Optional: if set, webhook requires Authorization: Bearer <value>
WAZZUP_WEBHOOK_BEARER=
# Staging safety: live bot POST only to allowlisted phones
WAZZUP_LIVE_ALLOWLIST_ENABLED=true
WAZZUP_LIVE_ALLOWLIST_PHONES=
WAZZUP_STAGE_MODE=true
# Agent 7 owner outreach from Agent 6 (default off for WA parity phase 1)
AGENT7_LIVE_OUTREACH_ENABLED=false
# Source-native fallback channels (independent gates; default OFF)
AGENT7_FACEBOOK_MESSENGER_ENABLED=false
AGENT7_AIRBNB_MESSAGES_ENABLED=false
# Conservative Airbnb messaging limits (below platform maximum)
AIRBNB_OWNER_MESSAGES_MAX_PER_HOUR=3
AIRBNB_OWNER_MESSAGES_MAX_PER_DAY=12
# Optional profile overrides
# Facebook Messenger temporarily reuses Agent1 Marketplace parser profile:
#   agent_1_parser/fb_parser/.fb_profile  (same as FB_BROWSER_PROFILE)
# Override only if you need a separate outreach profile later.
# AGENT7_FACEBOOK_PROFILE_DIR=
# AGENT7_AIRBNB_PROFILE_DIR=
# AGENT7_BROWSER_PROFILES_DIR=
# AGENT7_BROWSER_FAILURES_DIR=

# ---------- amoCRM Custom Chat Channels (Agent7 FB / Airbnb) ----------
# Channel registration requires amoCRM support ticket (not creatable via API).
# After support issues channel_id + secret + bot_id, fill below and run:
#   python3 scripts/amo_chat_setup.py connect-facebook
#   python3 scripts/amo_chat_setup.py connect-airbnb
AMO_CHAT_AMOJO_BASE_URL=https://amojo.amocrm.ru
AMO_CHAT_ACCOUNT_ID=
# Existing amoCRM integration UUID (do not rotate / invent a new one)
AMO_CHAT_CLIENT_UUID=831ec8bc-1565-4c9c-a10d-80b4162dadb6
# Public HTTPS base for Chat API registration webhook (no localhost)
AMO_CHAT_PUBLIC_BASE_URL=https://api.open-home.online
# Keep AMO_CHAT_OWNER_SILENT=true to avoid Неразобранное client leads
AMO_CHAT_OWNER_SILENT=true
AMO_CHAT_WEBHOOK_ENABLED=false
# Live import into amojo (default OFF during development)
AMO_CHAT_MIRROR_LIVE=false
AMO_CHAT_CONNECT_LIVE=false
# Local default :8766; production systemd forces 127.0.0.1:8000 behind NGINX
# AMO_CHAT_WEBHOOK_HOST=127.0.0.1
# AMO_CHAT_WEBHOOK_PORT=8766
# OPENHOME_API_PRODUCTION=false
AMO_CHAT_FB_TITLE=Open Home | Facebook Marketplace
AMO_CHAT_FB_CHANNEL_ID=
AMO_CHAT_FB_CHANNEL_SECRET=
AMO_CHAT_FB_SCOPE_ID=
AMO_CHAT_FB_BOT_ID=
AMO_CHAT_AIRBNB_TITLE=Open Home | Airbnb
AMO_CHAT_AIRBNB_CHANNEL_ID=
AMO_CHAT_AIRBNB_CHANNEL_SECRET=
AMO_CHAT_AIRBNB_SCOPE_ID=
AMO_CHAT_AIRBNB_BOT_ID=

# WhatsApp Business native-list UI sync (OPTIONAL, secondary visual only)
# Canonical role remains Agent 6/7 + amoCRM. Default OFF.
# VPS: use native Chrome + CDP (see whatsapp_ui_sync/DEPLOY_VPS.md)
WHATSAPP_UI_SYNC_ENABLED=false
WHATSAPP_UI_DRY_RUN=true
WHATSAPP_UI_HEADLESS=false
WHATSAPP_UI_PROFILE_DIR=
WHATSAPP_UI_CLIENT_LIST_NAME=Client
WHATSAPP_UI_OWNER_LIST_NAME=Owner
WHATSAPP_UI_AGENT_LIST_NAME=Owner
WHATSAPP_UI_ACTION_DELAY_MS=2000
WHATSAPP_UI_MAX_ATTEMPTS=3
WHATSAPP_UI_PAGE_LOAD_TIMEOUT_MS=90000
WHATSAPP_UI_READY_EXTRA_WAIT_MS=5000
WHATSAPP_UI_BROWSER_CHANNEL=chrome
WHATSAPP_UI_LOCALE=ru-RU
WHATSAPP_UI_CDP_URL=http://127.0.0.1:9222
WHATSAPP_UI_USE_XVFB=true
WHATSAPP_UI_CHROME_BIN=

# Canonical contact role + dual sync (event-driven; NO global backfill)
# Keep false until ready for ONE controlled real auto-role event.
CONTACT_ROLE_AUTO_ASSIGN_ENABLED=false
CONTACT_ROLE_AMO_SYNC_ENABLED=false
CONTACT_ROLE_AMO_DRY_RUN=true
CONTACT_ROLE_AMO_PROCESS_ASYNC=true
# Arm only when ready for the FIRST real Agent7 OWNER/AGENT outreach.
# Consumes one event then stays off via local one_shot state (env not rewritten).
CONTACT_ROLE_ONE_SHOT_LIVE_TEST=false

# Legacy Green-API placeholders (unused while WA_PROVIDER=wazzup)
WA_INSTANCE_ID=
WA_API_TOKEN=

